  },
  "homepage": "https://github.com/LachlanArthur/eml-view#readme",
  "dependencies": {
    "postal-mime": "^2.4.3"
  },
  "devDependencies": {
    "@shoelace-style/shoelace": "^2.20.1",
    "esbuild": "^0.25.4",
    "typescript": "^5.8.3"
  }
